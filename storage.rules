rules_version = '2';

// Firebase Storage rules.
// Files are kept per school: schools/{schoolId}/... . Role and school come from
// the user's ID token custom claims, set by the server when the account is
// created (src/lib/firebase/admin.ts syncUserClaims).
service firebase.storage {
  match /b/{bucket}/o {
    function isSuper() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }
    function inSchool(schoolId) {
      return request.auth != null && request.auth.token.schoolId == schoolId;
    }

    // schools/{schoolId}/announcements/{uploaderUid}/{fileId}
    // Members of the school can view; admins (and superadmins) upload/delete
    // their own files, up to 25 MB each.
    match /schools/{schoolId}/announcements/{uid}/{fileId} {
      allow read: if isSuper() || inSchool(schoolId);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && (isSuper() || (inSchool(schoolId) && request.auth.token.role == 'admin'))
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if request.auth != null
        && (isSuper() || (inSchool(schoolId) && request.auth.token.role == 'admin'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
