# ==============================================================================
# KMMS - Khendeq Medresah Management System
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# Fill in your project secrets. Never commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Web App Configuration (Required)
# ------------------------------------------------------------------------------
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 2. Server-side Firebase Admin SDK Credentials (Required for Server Actions & Cron)
# ------------------------------------------------------------------------------
# Option A (Recommended for Local Dev & Vercel): Single-line JSON string of service account key
# Generate from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
#
# Option B (Recommended for GCP / Cloud Run / App Hosting):
# Leave blank to use Application Default Credentials (ADC), or specify file path:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------------------------------------------
# 3. Scheduled Cron & Background Jobs
# ------------------------------------------------------------------------------
# Shared secret for scheduled /api/cron endpoints (e.g. missing attendance check)
# Requests must carry header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-strong-random-secret-here

# Application timezone (defaults to Africa/Addis_Ababa)
APP_TIMEZONE=Africa/Addis_Ababa

# ------------------------------------------------------------------------------
# 4. Master Admin Seeding & Local Backup Authorization (Optional)
# ------------------------------------------------------------------------------
# Used by `npm run seed:admin` and `npm run backup:db`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Master Admin

# ------------------------------------------------------------------------------
# 5. External SMS Gateway Configuration (Phase 4 Notifications)
# ------------------------------------------------------------------------------
# SMS_PROVIDER=sandbox # Options: sandbox | afromessage | production
# SMS_API_KEY=your-afromessage-api-key-here
# SMS_SENDER_NAME=KMMS
# SMS_IDENTIFIER_ID=your-sender-identifier-id